# AutoMate Showcase — .gitignore

# Environment & secrets
.env
.env.local
.env.*.local
*.key
*.pem
*.cert

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Output / generated files
output/
*.zip
*.docx  # Template source files not included in showcase

# Screenshots should be added manually, not auto-generated
# screenshots/ is intentionally NOT in .gitignore — add screenshots manually

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg
.venv/
venv/

# Node
node_modules/

# Logs
*.log
